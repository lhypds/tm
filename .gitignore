node_modules/
.vscode
.DS_Store
.env
taskmgr.json
*.tmp

# built web UI
dist/

# web UI login accounts
/data/users.json

# what taskmgrd pushes to this server (see README, "Sync daemon"), and the tasks of the works and
# repositories added in the web UI without a folder of their own
/data/origins/
/data/.sync-tmp/
/data/.sync-state.json
/data/.sync-blobs/

# sync logs: the daemon's, the one of tm push / tm pull by hand, and on a sync server one per machine
/logs/*.log
/.tm-sync-state.json
/.tm-hash-cache.json
# how taskmgrd's last pull went, for the web UI's status bar
/.tm-poll-state.json
