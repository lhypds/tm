      "keys": "tab",
      "desc": "switch between the tree and the tasks"
    },
    "add": {
      "keys": "a / n",
      "desc": "add a task (a subtask of the selected task, when there is one)"
    },
    "unselect": {
      "keys": "esc",
      "desc": "drop the selection, so a / n add a task at the top"
    },
    "edit": {
      "keys": "e / i; enter in list",
      "desc": "edit the selected task"
    },
    "open": {
      "keys": "enter in progress",
      "desc": "open the task folder"
    },
    "copy": {
      "keys": "⌘c / ctrl+c",
      "desc": "copy the selected task's id for tm run (repository:id or work:id)"
    },
